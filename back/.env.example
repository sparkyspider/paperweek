# Copy to back/.env and fill in. Never commit back/.env (see root .gitignore).

# Postgres — role `productivity` owns database `productivity` (see auth/README.md).
DATABASE_URL="postgresql://productivity:CHANGEME@localhost:5432/productivity?schema=public"

PORT=3201
NODE_ENV=development
FRONT_BASE_URL=http://localhost:3200

# Zitadel — shared local instance from co-sy-v2/auth, own org "Productivity".
# All values below are produced by auth/bootstrap-productivity.sh — never typed by hand.
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_ORG_ID=
ZITADEL_PROJECT_ID=
# Least-privilege login-broker PAT (prod-back machine user, IAM_LOGIN_CLIENT).
ZITADEL_BACK_PAT=
# SPA OIDC app's client id (Productivity Front).
ZITADEL_OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:3200/auth/callback

# Optional — set after seeding, only needed to run `npm run prisma:seed` again.
# MARK_ZITADEL_USER_ID=
