# Copy to back/.env and fill in. Never commit back/.env (see root .gitignore).

# Postgres — Paperweek's OWN database (its data never goes to Co-Sy).
DATABASE_URL=postgresql://productivity:<password>@localhost:5432/productivity?schema=public

PORT=3201
NODE_ENV=development
FRONT_BASE_URL=http://localhost:3200

# Co-Sy satellite settings — exactly the lines Co-Sy's `satellite:register` prints (or the
# app's Details dialog in Co-Sy's "Your apps"). None of them is a secret.
COSY_ISSUER=http://localhost:8080
# Co-Sy's API, no trailing slash, no /api: the guard asks <this>/auth/token-status.
COSY_API_URL=http://localhost:3001
SATELLITE_PROJECT_ID=
# Comma-separated: the front's sign-in application id(s).
SATELLITE_CLIENT_IDS=
# The organisation that owns Paperweek in Co-Sy (Public). Only roles it granted count.
SATELLITE_OWNER_ORG=

# Optional — only needed to run `npm run prisma:seed` (the Zitadel `sub` the starter themes belong to).
# MARK_ZITADEL_USER_ID=
